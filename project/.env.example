# Copy this file to project/.env before running Docker Compose.
# Do not commit project/.env. Real values should be shared through the team drive or by secure mail.

POSTGRES_DB=ghosthouses
POSTGRES_USER=ghosthouses_app_user
POSTGRES_PASSWORD=replace-with-strong-database-password

PGADMIN_DEFAULT_EMAIL=replace-with-admin-email@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-strong-pgadmin-password

JWT_ISSUER=ghosthouses
JWT_AUDIENCE=ghosthouses-clients
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
JWT_EXPIRATION_MINUTES=120
