@startuml
skinparam shadowing false

actor "Municipality User" as User
cloud "Public Internet" as Net
node "DNS + TLS" as DNS
node "Reverse Proxy / Load Balancer" as LB
node "App Server" as AppSrv {
  node "Web API (ASP.NET)" as Api
  node "Static Frontend" as Fe
}
node "Database Server\n(PostgreSQL)" as Db
node "Object Storage\n(Building Images)" as Storage
node "External Systems" as External {
  node "SSO / 2FA Provider" as SSO
  node "Municipal Data APIs" as DataApis
}

User --> Net
Net --> DNS
DNS --> LB
LB --> Api : HTTPS
LB --> Fe : HTTPS
Api --> Db : SQL
Api --> Storage : Store/Retrieve
Api --> SSO : Auth
Api --> DataApis : Sync

@enduml
