@startuml
skinparam shadowing false

actor "Client Browser" as Client
cloud "Internet" as Net
node "Home Router\n(Port Forwarding)" as Router
node "Host PC\n(Team member)" as Host {
  node "Docker Compose" as Compose {
    node "ghosthouses-web\nASP.NET + Static Frontend" as Web
    node "ghosthouses-db\nPostgreSQL" as Db
    node "ghosthouses-pgadmin" as PgAdmin
  }
}

Client --> Net
Net --> Router
Router --> Web : HTTP/HTTPS
Web --> Db : SQL
PgAdmin --> Db : Admin

@enduml
