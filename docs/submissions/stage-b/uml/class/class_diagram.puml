@startuml
hide circle
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam DefaultFontName Arial
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam ArrowColor #334155
skinparam ClassBorderColor #1D4ED8
skinparam ClassBackgroundColor #DBEAFE
skinparam ClassFontColor #0F172A
skinparam ClassAttributeFontColor #0F172A
skinparam ClassStereotypeFontColor #0F172A
skinparam InterfaceBorderColor #1D4ED8
skinparam InterfaceBackgroundColor #DBEAFE
skinparam InterfaceFontColor #0F172A
skinparam EnumBorderColor #1D4ED8
skinparam EnumBackgroundColor #DBEAFE
skinparam EnumFontColor #0F172A

class Building {
  +Id : int
  +BuildingName : string
  +StreetCode : int?
  +StreetName : string
  +HouseNumber : string
  +BldSivug : int?
  +ShikumStatus : BuildingStatus
  +StatusSummary : string
  +Longitude : double?
  +Latitude : double?
  +GushM : int?
  +ParcelM : int?
  +GushS : int?
  +ParcelS : int?
  +OwnerDetails : string?
  +HolderDetails : string?
  +ArnonaDept : Money?
}

class Street {
  +StreetId : int
  +Name : string
  +Buildings : ICollection<Building>
}

class BuildingLog {
  +Id : int
  +BuildingId : int
  +CreatedByUserId : Guid?
  +Title : string
  +Message : string
  +Category : string
  +Severity : string
  +CreatedAt : DateTimeOffset
  +UpdatedAt : DateTimeOffset?
}

class AppUser {
  +Id : Guid
  +Username : string
  +Email : string
  +PasswordHash : string
  +Role : UserRole
  +TwoFactorEnabled : bool
  +CreatedAt : DateTimeOffset
  +LastLoginAt : DateTimeOffset?
}

class AuditEntry {
  +Id : int
  +EntityType : string
  +EntityId : string
  +Action : string
  +Changes : string
  +PerformedByUserId : Guid?
  +CreatedAt : DateTimeOffset
}

class Money <<dataType>> {
  +Amount : decimal
}

class FieldSpecAttribute {
  +Category : string
  +FieldName : string
  +SelectTableName : string?
  +IncludeInEventLog : bool
}

enum BuildingStatus <<enumeration>> {
  Unknown
  MappingBarriersAndSolution
  OwnershipTransfer
  DevelopmentBarriers
  OwnerConsideringAction
  PreparingRehabPlan
  PlanApprovedPreparingExecution
  InExecution
  OccupancyProcess
}

enum UserRole <<enumeration>> {
  Viewer
  Editor
  Admin
}

class AppDbContext {
  +Buildings : DbSet<Building>
  +Streets : DbSet<Street>
  +Users : DbSet<AppUser>
  +BuildingLogs : DbSet<BuildingLog>
  +AuditEntries : DbSet<AuditEntry>
}

interface ITokenService <<interface>> {
  +CreateToken() : string
}

class TokenService {
  +CreateToken() : string
}

interface ITwoFactorService <<interface>> {
  +IssueCode() : (string, string)
  +ValidateCode() : bool
}

class TwoFactorService {
  +IssueCode() : (string, string)
  +ValidateCode() : bool
}

interface IAuditService <<interface>> {
  +RecordAsync() : Task
}

class AuditService {
  +RecordAsync() : Task
}

interface IGisSnapshotService <<interface>> {
  +CreateBuildingSnapshotAsync() : Task<byte[]?>
}

class ArcGisSnapshotService {
  +CreateBuildingSnapshotAsync() : Task<byte[]?>
}

class BuildingRules {
  {static} +ResolveRehabSivugValue() : int?
  {static} +TryParseStreetId() : int?
  {static} +TryResolveSelectValue() : int?
  {static} +ConvertFieldValue() : object?
}

class StreetRules {
  {static} +ReservedNoStreetId : int
  {static} +TryParseStreetId() : int?
  {static} +ValidateValues() : ValidationResult
}

class BuildingsExcelImporter {
  {static} +ReadBuildingsFromStream() : IReadOnlyList<Building>
  {static} +SeedFromFileAsync() : Task
}

class StreetsExcelImporter {
  {static} +ReadStreetsFromStream() : IReadOnlyList<Street>
  {static} +SeedFromFileAsync() : Task
}

class SelectTables {
  {static} +GetOptions() : IReadOnlyList<SelectOption>
  {static} +GetAllTables() : IReadOnlyDictionary<string, IReadOnlyList<SelectOption>>
}

class SelectOption <<dataType>> {
  +Value : int
  +Label : string
}

abstract class ControllerBase

abstract class ApiControllerBase {
  #CurrentUserId : Guid?
}

class AuthController {
  +Login() : ActionResult<LoginChallengeResponse>
  +VerifyTwoFactor() : ActionResult<AuthenticatedUserResponse>
  +GetCurrentUser() : ActionResult<UserSummaryDto>
}

class BuildingsController {
  +GetBuildings() : ActionResult<PaginatedResult<BuildingSummaryDto>>
  +GetBuilding() : ActionResult<BuildingDetailDto>
  +CreateBuilding() : ActionResult<BuildingSummaryDto>
  +UpdateBuilding() : ActionResult
  +DeleteBuilding() : ActionResult
  +RestoreBuilding() : ActionResult<BuildingSummaryDto>
  +ExportBuildingCard() : IActionResult
  +ExportBuildingCards() : IActionResult
  +ImportBuildingsPreview() : ActionResult<ImportPreviewResponse>
  +ImportBuildingsApply() : IActionResult
  +ConvertBuildingsTemplate() : IActionResult
}

class LogsController {
  +GetLogs() : ActionResult<PaginatedResult<BuildingLogDto>>
  +GetBuildingLogs() : ActionResult<IEnumerable<BuildingLogDto>>
  +CreateLog() : ActionResult<BuildingLogDto>
  +UpdateLog() : ActionResult
}

class UsersController {
  +GetUsers() : ActionResult<IEnumerable<UserSummaryDto>>
  +GetUser() : ActionResult<UserSummaryDto>
  +CreateUser() : ActionResult<UserSummaryDto>
  +UpdateUser() : ActionResult
  +ResetTwoFactor() : ActionResult
  +SetPassword() : ActionResult
}

class StreetsController {
  +GetAll() : ActionResult<IEnumerable<StreetDto>>
  +Get() : ActionResult<StreetDto>
  +Create() : ActionResult<StreetDto>
  +Update() : ActionResult
  +Delete() : ActionResult
  +PreviewImport() : ActionResult<StreetImportPreviewResponse>
  +ApplyImport() : IActionResult
  +ConvertStreetsTemplate() : IActionResult
}

class SelectTablesController {
  +GetByName() : ActionResult<IEnumerable<SelectOption>>
  +GetAll() : ActionResult<IDictionary<string, IReadOnlyList<SelectOption>>>
}

class HealthController {
  +GetDatabaseHealth() : IActionResult
}

ControllerBase <|-- ApiControllerBase
ControllerBase <|-- HealthController
ControllerBase <|-- SelectTablesController
ControllerBase <|-- StreetsController
ApiControllerBase <|-- AuthController
ApiControllerBase <|-- BuildingsController
ApiControllerBase <|-- LogsController
ApiControllerBase <|-- UsersController

ITokenService <|.. TokenService
ITwoFactorService <|.. TwoFactorService
IAuditService <|.. AuditService
IGisSnapshotService <|.. ArcGisSnapshotService

Street "1" -- "0..*" Building
Building "1" -- "0..*" BuildingLog
AppUser "0..1" -- "0..*" BuildingLog
AppUser --> UserRole
Building --> BuildingStatus
Building --> Money
Building ..> FieldSpecAttribute

AppDbContext ..> Building
AppDbContext ..> Street
AppDbContext ..> AppUser
AppDbContext ..> BuildingLog
AppDbContext ..> AuditEntry

AuthController ..> AppDbContext
AuthController ..> AppUser
AuthController ..> ITokenService
AuthController ..> ITwoFactorService
AuthController ..> IAuditService

BuildingsController ..> AppDbContext
BuildingsController ..> IAuditService
BuildingsController ..> IGisSnapshotService
BuildingsController ..> BuildingRules
BuildingsController ..> BuildingsExcelImporter

LogsController ..> AppDbContext
LogsController ..> IAuditService
UsersController ..> AppDbContext
UsersController ..> IAuditService
StreetsController ..> AppDbContext
StreetsController ..> StreetRules
StreetsController ..> StreetsExcelImporter
SelectTablesController ..> SelectTables
HealthController ..> AppDbContext

AuditService ..> AppDbContext
ArcGisSnapshotService ..> AppDbContext
ArcGisSnapshotService ..> Building
TokenService ..> AppUser
TwoFactorService ..> AppUser

BuildingsExcelImporter ..> Building
StreetsExcelImporter ..> Street
BuildingRules ..> SelectTables
BuildingRules ..> FieldSpecAttribute
SelectTables o-- SelectOption

@enduml
