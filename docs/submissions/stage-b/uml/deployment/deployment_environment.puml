@startuml
title <b>GhostHouses Stage B Deployment Environment - UML 2.5.1</b>

skinparam shadowing false
skinparam packageStyle rectangle
left to right direction

node "Municipality Private Network" {
  actor "Municipality Users" as users
  actor "IT / DB Admin" as itadmin

  node "Municipality Windows Server VM" {
    package "Docker Host (Docker Compose)" as dockerhost {
      package "app-net" as appnet {
        node "Frontend Container\nNginx + React build\nInternal port: 443 (HTTPS)\nExternal port: 443 (HTTPS)" as frontend
        node "Backend API Container\nASP.NET Core\nInternal port: 8080 (HTTP)\nExternal port: none" as backend
        artifact "Mock OTP Module\nInside backend process\nNo external provider" as otp
        frontend -[hidden]right- backend
        backend -[hidden]down- otp
      }

      package "db-net" as dbnet {
        database "PostgreSQL Container\nInternal port: 5432\nExternal port: none\nVolume: db-data" as db
      }

      package "admin-net" as adminnet {
        node "pgAdmin Container\nDatabase admin UI\nInternal port: 443 (HTTPS)\nExternal port: 8443 (HTTPS)\nVolume: pgadmin-data" as pgadmin
      }

      backend .. dbnet : member
      db .. adminnet : member
      backend -[hidden]right- db
      db -[hidden]right- pgadmin
    }
  }
}

node "Internet / Public HTTPS" as internet {
  node "Docker Image Registries\nDocker Hub + Microsoft Container Registry\nBuild/deploy time only" as registries
  node "Haifa Municipality GIS\nArcGIS public API\nActive runtime integration" as gis
}

users --> frontend : HTTPS 443
itadmin --> pgadmin : HTTPS 8443

frontend --> backend : HTTP 8080 (/api)
backend --> frontend : HTTPS 443 (reachable)
backend --> otp : internal mock\nOTP code
backend --> db : PostgreSQL 5432
pgadmin --> db : PostgreSQL 5432 (admin)
db --> backend : TCP 8080 (reachable)
db --> pgadmin : TCP 443 (reachable)

backend -down-> gis : outbound HTTPS 443\nGIS data + map snapshots
dockerhost .down.> registries : outbound HTTPS 443\nimage pull at build/deploy

@enduml
