@startuml

skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam DefaultFontName Arial
skinparam ArrowColor #334155
skinparam NodeBorderColor #1D4ED8
skinparam NodeBackgroundColor #DBEAFE
skinparam NodeFontColor #0F172A
skinparam ArtifactBorderColor #1D4ED8
skinparam ArtifactBackgroundColor #DBEAFE
skinparam ArtifactFontColor #0F172A
left to right direction

node "«device»\nMunicipality User Workstation" as userWorkstation #EFF6FF {
  node "«executionEnvironment»\nWeb Browser" as userBrowser #DBEAFE
}

node "«device»\nIT Admin Workstation" as adminWorkstation #FFF7ED {
  node "«executionEnvironment»\nWeb Browser" as adminBrowser #FFEDD5
}

node "«device»\nMunicipality Windows Server VM" as serverVm #F8FAFC {
  node "«executionEnvironment»\nDocker Engine\nDocker Compose" as dockerEngine #FFFFFF {
    node "«executionEnvironment»\nFrontend Container\nNginx" as frontend #DBEAFE {
      artifact "«artifact»\nReact static build" as reactBuild #EFF6FF
    }

    node "«executionEnvironment»\nBackend API Container\nASP.NET Core\nmocked 2FA" as backend #EDE9FE {
      artifact "«artifact»\nGhostHouses API executable" as apiArtifact #F5F3FF
    }

    node "«executionEnvironment»\nPostgreSQL Container" as postgres #DCFCE7 {
      artifact "«artifact»\nPostgreSQL data volume" as dbVolume #ECFDF5
    }

    node "«executionEnvironment»\npgAdmin Container" as pgadmin #FFEDD5 {
      artifact "«artifact»\npgAdmin data volume" as pgadminVolume #FFF7ED
    }
  }
}

node "«executionEnvironment»\nHaifa Municipality GIS\nArcGIS public API" as gis #CCFBF1
node "«executionEnvironment»\nDocker Image Registries\nDocker Hub + Microsoft Container Registry" as registries #F1F5F9

userBrowser -- frontend : HTTPS
adminBrowser -- pgadmin : HTTPS

frontend -- backend : HTTP (/api)\napp-net
backend -- postgres : PostgreSQL\ndb-net
pgadmin -- postgres : PostgreSQL\nadmin-net / db-net

backend -- gis : outbound HTTPS\nGIS data + map snapshots
dockerEngine -- registries : outbound HTTPS\nimage pull at build/deploy

frontend -[hidden]right- backend
backend -[hidden]right- postgres
postgres -[hidden]right- pgadmin

@enduml
