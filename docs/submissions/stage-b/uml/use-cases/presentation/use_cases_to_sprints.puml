rectangle "User Stories" {
  artifact "#21 As an admin, I want users to log in with 2FA\nso that only authorized people can use the system." as US_21 #F8FAFC;line:2563EB
  artifact "#22 As an admin, I want to set municipality user\npermissions to view/edit/can't access so that\nsystem access is controlled." as US_22 #F8FAFC;line:2563EB
  artifact "#24 As a viewer, I want to search and filter buildings\n(street, house no., nickname, status/category, area)\nso that I can quickly find relevant records." as US_24 #F8FAFC;line:0891B2
  artifact "#26 As a viewer, I want to produce a building card image\nto include in presentations." as US_26 #F8FAFC;line:DC2626
  artifact "#27 As an editor, I want to add new buildings\nso that the database stays current." as US_27 #F8FAFC;line:0891B2
  artifact "#28 As an editor, I want to update existing buildings\nso that errors and changes are reflected promptly." as US_28 #F8FAFC;line:0891B2
  artifact "#29 As an editor, I want to remove buildings\n(with safeguards) so that obsolete or duplicate\nentries are cleaned up." as US_29 #F8FAFC;line:0891B2
  artifact "#34 As a viewer, I want a full audit trail of who changed\nwhat and when so that compliance requirements are met." as US_34 #F8FAFC;line:0891B2
  artifact "#76 As a municipality staff user (admin/editor),\nI want to export the buildings table (optionally with\ncurrent filters) to an Excel file, so that I can keep\na backup of the database locally, and restore it later\nvia \"import from excel\"." as US_76 #F8FAFC;line:0891B2
  artifact "#84 As a viewer, I want to view and pan around a map\nso I can understand abandoned building locations" as US_84 #F8FAFC;line:F59E0B
  artifact "#85 As a viewer, I want to select an area of buildings\non the map so I can see their details and statuses" as US_85 #F8FAFC;line:F59E0B
  artifact "#94 As municipality staff, I want GhostHouses deployed\non the municipality server so the system can be used\ninside the municipality network" as US_94 #F8FAFC;line:DC2626
}

